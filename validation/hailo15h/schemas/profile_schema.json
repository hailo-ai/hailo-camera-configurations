{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Media Library schema for version configuration",
    "type": "object",
    "properties": {
        "version": {
            "type": "string"
        },
        "metadata": {
            "type": "object",
            "properties": {
                "architecture": {
                    "type": "string",
                    "enum": [
                        "hailo15h",
                        "hailo15l"
                    ]
                },
                "description": {
                    "type": "string"
                },
                "content_hash": {
                    "type": "string"
                },
                "generation_timestamp": {
                    "type": "string"
                }
            },
            "required": [
                "architecture",
                "description",
                "content_hash",
                "generation_timestamp"
            ]
        },
        "application_settings": {
            "type": "string"
        },
        "encoded_output_streams": {
            "type": "array",
            "items": [
                {
                    "type": "object",
                    "properties": {
                        "encoding": {
                            "type": "string"
                        },
                        "masking": {
                            "type": "string"
                        },
                        "osd": {
                            "type": "string"
                        },
                        "stream_id": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "encoding",
                        "masking",
                        "osd",
                        "stream_id"
                    ]
                }
            ]
        },
        "iq_settings": {
            "type": "string"
        },
        "sensor_config": {
            "type": "string"
        },
        "stabilizer_settings": {
            "type": "string"
        }
    },
    "required": [
        "version",
        "metadata",
        "application_settings",
        "encoded_output_streams",
        "iq_settings",
        "sensor_config",
        "stabilizer_settings"
    ],
    "additionalProperties": true,
    "$id": "profile_schema"
}