{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Media Library schema for version configuration",
    "type": "object",
    "properties": {
        "version": {
            "type": "string"
        },
        "metadata": {
            "type": "object",
            "properties": {
                "architecture": {
                    "type": "string",
                    "enum": [
                        "hailo15h",
                        "hailo15l"
                    ]
                },
                "description": {
                    "type": "string"
                },
                "content_hash": {
                    "type": "string"
                },
                "generation_timestamp": {
                    "type": "string"
                }
            },
            "required": [
                "architecture",
                "description",
                "content_hash",
                "generation_timestamp"
            ]
        },
        "masking": {
            "type": "object",
            "properties": {
                "mask_type": {
                    "type": "string",
                    "enum": [
                        "COLOR",
                        "PIXELIZATION"
                    ]
                },
                "pixelization_size": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 64
                },
                "color_value": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                    },
                    "minItems": 3,
                    "maxItems": 3
                },
                "static_privacy_mask": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "masks": {
                            "type": "array",
                            "items": {
                                "$ref": "masking_schema#/definitions/polygon"
                            },
                            "maxItems": 8
                        }
                    },
                    "required": [
                        "enabled",
                        "masks"
                    ],
                    "additionalProperties": false
                },
                "dynamic_privacy_mask": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "dilation_size": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 15
                        },
                        "analytics": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "analytics_data_id": {
                                        "type": "string"
                                    },
                                    "masked_labels": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "required": [
                                    "masked_labels"
                                ],
                                "additionalProperties": false
                            }
                        },
                        "timeout_ms": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "delta_ms": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "query_type": {
                            "type": "string",
                            "enum": [
                                "Closest",
                                "Exact",
                                "WithinDelta"
                            ]
                        },
                        "masked_labels": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "label_to_class_id": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "label": {
                                        "type": "string"
                                    },
                                    "id": {
                                        "type": "integer",
                                        "minimum": 0
                                    }
                                },
                                "required": [
                                    "label",
                                    "id"
                                ],
                                "additionalProperties": false
                            }
                        }
                    },
                    "required": [
                        "enabled",
                        "dilation_size"
                    ],
                    "oneOf": [
                        {
                            "required": [
                                "analytics",
                                "timeout_ms",
                                "delta_ms",
                                "query_type"
                            ],
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "masked_labels"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "label_to_class_id"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "masked_labels",
                                "label_to_class_id"
                            ],
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "analytics"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "timeout_ms"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "delta_ms"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "query_type"
                                        ]
                                    }
                                ]
                            }
                        }
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "mask_type",
                "pixelization_size",
                "color_value"
            ]
        },
        "additionalProperties": false
    },
    "required": [
        "version",
        "metadata"
    ],
    "additionalProperties": true,
    "definitions": {
        "vertex": {
            "$id": "vertex",
            "type": "object",
            "properties": {
                "x": {
                    "type": "integer",
                    "minimum": 0
                },
                "y": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "x",
                "y"
            ],
            "additionalProperties": false
        },
        "polygon": {
            "$id": "polygon",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "polygon_points": {
                    "type": "array",
                    "items": {
                        "$ref": "masking_schema#/definitions/vertex"
                    },
                    "maxItems": 8
                }
            },
            "required": [
                "name",
                "polygon_points"
            ],
            "additionalProperties": false
        }
    },
    "$id": "masking_schema"
}